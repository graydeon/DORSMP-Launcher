{
  "name": "dorsmp-launcher",
  "productName": "DORSMP Launcher",
  "author": "graydeon",
  "description": "Launcher for the DORSMP modded Minecraft server",
  "private": true,
  "version": "1.0.5",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "release:win": "npm run build && electron-builder --win",
    "release:mac": "npm run build && electron-builder --mac",
    "release:lin": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.dorsmp.launcher",
    "productName": "DORSMP Launcher",
    "copyright": "Copyright © 2026 graydeon",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist",
      "dist-electron",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DORSMP Launcher",
      "deleteAppDataOnUninstall": true,
      "artifactName": "DORSMP-Launcher-Setup-${version}.${ext}",
      "uninstallDisplayName": "DORSMP Launcher"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "DORSMP-Launcher-${version}-${arch}.${ext}"
    },
    "dmg": {
      "background": "build/background.png",
      "icon": "build/dmg-icon.icns",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 430
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "description": "Launcher for the DORSMP modded Minecraft server",
      "artifactName": "DORSMP-Launcher-${version}.${ext}",
      "maintainer": "graydeon"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://launcher.graydeon.com/files/bootstraps"
      }
    ]
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "eml-lib": "^2.7.4",
    "marked": "^18.1.1",
    "skinview3d": "^3.4.2",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2"
  }
}
